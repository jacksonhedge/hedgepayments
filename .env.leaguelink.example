# Server Configuration
NODE_ENV=development
PORT=3000
HOST=localhost

# API Configuration
API_VERSION=v1
API_PREFIX=/api
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=100

# Security
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRY=7d
ENCRYPTION_KEY=32-character-encryption-key-here
WEBHOOK_SECRET=webhook-signing-secret-change-this

# Database
DATABASE_URL=postgresql://leaguelink:leaguelink@localhost:5432/leaguelink_db
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_TTL=3600

# Browser Service
BROWSER_WS_ENDPOINT=ws://localhost:3001
BROWSER_HEADLESS=true
BROWSER_TIMEOUT=30000
MAX_BROWSERS=10
MAX_PAGES_PER_BROWSER=5

# Puppeteer Settings
PUPPETEER_EXECUTABLE_PATH=
STEALTH_MODE=true
USER_AGENT_ROTATE=true

# Platform-Specific Settings
ESPN_BASE_URL=https://lm-api-reads.fantasy.espn.com/apis/v3/games
ESPN_FRONTEND_URL=https://fantasy.espn.com
YAHOO_BASE_URL=https://football.fantasysports.yahoo.com
SLEEPER_BASE_URL=https://api.sleeper.app/v1
NFL_BASE_URL=https://fantasy.nfl.com

# ESPN Direct API Configuration
REQUEST_TIMEOUT=10000

# Client Credentials (for Plaid-style auth)
CLIENT_ID=your_client_id_change_this
CLIENT_SECRET=your_client_secret_change_this

# Webhook Configuration
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_RETRY_DELAY=5000
WEBHOOK_TIMEOUT=10000

# Logging
LOG_LEVEL=debug
LOG_FILE=logs/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:4001
CORS_CREDENTIALS=true

# Session Management
SESSION_EXPIRY=3600
SESSION_CLEANUP_INTERVAL=600

# Development
DEBUG=leaguelink:*
MOCK_MODE=false