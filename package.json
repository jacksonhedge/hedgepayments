{
  "name": "hedgepayments-website",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "docs"
  ],
  "scripts": {
    "dev": "next dev --port 3000",
    "dev:api": "cd packages/api && npm run dev",
    "dev:docs": "cd docs && npm run dev",
    "build": "next build",
    "build:all": "npm run build && cd packages/api && npm run build",
    "start": "next start --port 3000",
    "lint": "next lint",
    "clean": "rm -rf .next node_modules package-lock.json",
    "predeploy": "npm run build",
    "deploy": "firebase deploy --only hosting",
    "deploy:all": "firebase deploy",
    "deploy:github": "npm run build && touch out/.nojekyll"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Website for Hedge Payments",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@sendgrid/client": "^8.1.5",
    "@sendgrid/mail": "^8.1.5",
    "@supabase/supabase-js": "^1.35.7",
    "encoding": "^0.1.13",
    "firebase": "^12.2.1",
    "firebase-admin": "^13.5.0",
    "firebase-functions": "^6.4.0",
    "framer-motion": "^12.23.12",
    "next": "^14.2.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "axios": "^1.6.2",
    "cheerio": "^1.0.0-rc.12",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.2",
    "puppeteer": "^21.11.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/node": "^18.11.18",
    "@types/react": "^18.3.21",
    "@types/react-dom": "^18.3.7",
    "typescript": "^4.9.4"
  }
}
