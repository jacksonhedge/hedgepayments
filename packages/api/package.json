    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.8.1",
    "helmet": "^7.0.0",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.2",
    "knex": "^2.5.1",
    "make-error": "^1.3.6",
    "pg": "^8.11.1",
    "redis": "^4.6.7",
    "stripe": "^16.12.0",
    "uuid": "^9.0.0",
    "winston": "^3.10.0",
    "yn": "^3.1.1"
