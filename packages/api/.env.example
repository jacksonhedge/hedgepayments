# @hedge/api environment. Copy to .env and fill in. NEVER commit real keys.
PORT=3000
NODE_ENV=development

# Supabase (service role — server-only secret)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (test mode)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...     # from `stripe listen`

# Chance wallet
CHANCE_ANON_USER_ID=00000000-0000-0000-0000-0000000000a1
CHANCE_SUCCESS_URL=https://hedgepayments.com/chance/funded
CHANCE_CANCEL_URL=https://hedgepayments.com/chance/cancelled
CHANCE_EXTENSION_ORIGIN=*
