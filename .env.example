APPLE_PAY_CERTIFICATE_PATH=
APPLE_PAY_KEY_PATH=

# Google Pay
GOOGLE_PAY_MERCHANT_ID=
GOOGLE_PAY_MERCHANT_NAME=HedgePayments
GOOGLE_PAY_ENVIRONMENT=TEST

# ============================================
# BANKING & ACH
# ============================================

# Meld (Bank Connections)
MELD_API_KEY=
MELD_CLIENT_ID=your_meld_client_id
MELD_CLIENT_SECRET=your_meld_client_secret
