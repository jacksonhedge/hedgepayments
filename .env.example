SIGNIFYD_TEAM_ID=

# ============================================
# ANALYTICS & MONITORING
# ============================================

# Segment
SEGMENT_WRITE_KEY=

# Amplitude
AMPLITUDE_API_KEY=

# Mixpanel
MIXPANEL_TOKEN=

# DataDog
DATADOG_API_KEY=
DATADOG_APP_KEY=

# ============================================
# COMMUNICATION
# ============================================

# SendGrid (Email)
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@hedgepayments.com
SENDGRID_FROM_NAME=Hedge Payments
SENDGRID_MARKETING_LIST_ID=your_sendgrid_list_id

# Twilio (SMS)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890
TWILIO_PHONE_NUMBER=

# ConvertKit (Marketing)
CONVERTKIT_API_KEY=your_convertkit_api_key
CONVERTKIT_FORM_ID=your_convertkit_form_id

# Slack (signup notifications via Incoming Webhook)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# ============================================
# FEATURE FLAGS
# ============================================

# Enable/Disable Payment Methods
ENABLE_CARDS=true
ENABLE_ACH=true
ENABLE_WIRE=true
ENABLE_CRYPTO=true
ENABLE_BNPL=true
ENABLE_DIGITAL_WALLETS=true
ENABLE_INTERNATIONAL=true

# Provider Preferences
PRIMARY_CARD_PROCESSOR=stripe
PRIMARY_ACH_PROCESSOR=dwolla
PRIMARY_CRYPTO_PROCESSOR=coinbase
PRIMARY_BANK_CONNECTION=meld

# ============================================
# RATE LIMITS & SECURITY
# ============================================

# API Rate Limits
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_HOUR=1000

# Security
ENCRYPTION_KEY=
WEBHOOK_SIGNING_SECRET=

# Session
SESSION_SECRET=
SESSION_DURATION=86400

# ============================================
# TESTING & DEVELOPMENT
# ============================================

# Test Mode
TEST_MODE=true
BYPASS_KYC=false
BYPASS_2FA=false

# Mock Providers (for development)
USE_MOCK_PROVIDERS=false
MOCK_PAYMENT_SUCCESS_RATE=0.95

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# ============================================
# DEPLOYMENT & INFRASTRUCTURE
# ============================================

# CDN
CDN_URL=https://cdn.hedgepayments.com

# PostgreSQL (if not using Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/hedgepayments

# AWS (for file storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=hedgepayments-assets

# ============================================
# NOTES FOR IMPLEMENTATION
# ============================================

# 1. Payment Provider Priority:
#    - Cards: Stripe → Checkout.com → Direct Visa/MC
#    - ACH: Dwolla → Modern Treasury → Plaid
#    - Crypto: Coinbase Commerce → Circle
#    - BNPL: Klarna → Afterpay → Affirm → Sezzle

# 2. Geographic Coverage:
#    - US/Canada: All providers
#    - Europe: Stripe, Checkout, Klarna, Wise
#    - Asia: Alipay, WeChat Pay
#    - Latin America: PIX, Western Union

# 3. Integration Complexity (1-5):
#    - Stripe: 2 (Well documented)
#    - PayPal/Venmo: 3 (OAuth required)
#    - Cash App: 4 (Limited API)
#    - Visa Direct: 5 (Complex certification)
#    - Coinbase: 2 (Good API)
#    - Kalshi: 3 (Specialized market)

# 4. Compliance Requirements:
#    - PCI DSS: Required for card processing
#    - Money Transmitter License: State by state
#    - KYC/AML: Required for all
#    - FinCEN Registration: Required
#    - State-specific: CA, NY most stringent

# 5. Testing Credentials:
#    - Most providers offer sandbox environments
#    - Use test API keys prefixed with 'test_' or 'sandbox_'
#    - Test card: 4242 4242 4242 4242
#    - Test bank: 000123456789

# End of configuration