# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_URL=your_supabase_url

# SendGrid Configuration
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@hedgepayments.com
SENDGRID_FROM_NAME=Hedge Payments
SENDGRID_MARKETING_LIST_ID=your_sendgrid_list_id

# Meld OAuth Provider (Bank Connections)
MELD_CLIENT_ID=your_meld_client_id
MELD_CLIENT_SECRET=your_meld_client_secret
MELD_REDIRECT_URI=http://localhost:3001/auth/callback/meld

# Dwolla ACH Provider (Money Movement)
DWOLLA_KEY=your_dwolla_key
DWOLLA_SECRET=your_dwolla_secret
DWOLLA_WEBHOOK_SECRET=your_dwolla_webhook_secret
DWOLLA_MASTER_ACCOUNT_ID=your_dwolla_master_account_id

# API Configuration
API_PORT=3001
API_BASE_URL=http://localhost:3001
JWT_SECRET=your_jwt_secret_key_here
NODE_ENV=development

# Redis Configuration (for rate limiting and caching)
REDIS_URL=redis://localhost:6379

# Twilio Configuration (for SMS via SendGrid)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890

# ConvertKit Configuration (if still using)
CONVERTKIT_API_KEY=your_convertkit_api_key
CONVERTKIT_FORM_ID=your_convertkit_form_id