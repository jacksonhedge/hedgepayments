# HedgePayments Environment Variables
# Complete configuration for all payment providers

# ============================================
# CORE CONFIGURATION
# ============================================
NODE_ENV=development
API_URL=http://localhost:3000
API_PORT=3001
API_BASE_URL=http://localhost:3001
JWT_SECRET=your_jwt_secret_key_here
WEBHOOK_URL=https://your-domain.com/webhooks

# Database
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_KEY=your_supabase_service_key

# Redis Configuration
REDIS_URL=redis://localhost:6379

# ============================================
# CARD PROCESSORS
# ============================================

# Stripe (Primary processor for cards)
STRIPE_PUBLIC_KEY=pk_test_
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# Visa Direct (P2P & Payouts)
VISA_DIRECT_USER_ID=
VISA_DIRECT_PASSWORD=
VISA_DIRECT_CERTIFICATE_PATH=
VISA_DIRECT_KEY_PATH=
VISA_DIRECT_URL=https://sandbox.api.visa.com

# Mastercard Send
MASTERCARD_CONSUMER_KEY=
MASTERCARD_PRIVATE_KEY=
MASTERCARD_KEY_ALIAS=
MASTERCARD_KEY_PASSWORD=
MASTERCARD_SANDBOX_URL=https://sandbox.api.mastercard.com

# Checkout.com (Alternative processor)
CHECKOUT_PUBLIC_KEY=pk_test_
CHECKOUT_SECRET_KEY=sk_test_
CHECKOUT_WEBHOOK_SECRET=

# ============================================
# DIGITAL WALLETS & P2P
# ============================================

# PayPal & Venmo (Same credentials)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox
VENMO_CLIENT_ID=
VENMO_CLIENT_SECRET=

# Cash App (Block/Square)
CASHAPP_APPLICATION_ID=
CASHAPP_ACCESS_TOKEN=
CASHAPP_LOCATION_ID=
